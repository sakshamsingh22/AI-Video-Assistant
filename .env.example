# Required for Mistral-powered summarization, extraction and RAG
MISTRAL_API_KEY=

# Required only for Hinglish transcription via Sarvam
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v2.5

# Optional: Whisper model size (tiny, base, small, medium, large)
WHISPER_MODEL=small

# Optional local media download directory
AUDIO_DOWNLOAD_DIR=downloads
